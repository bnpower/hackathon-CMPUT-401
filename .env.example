# Required for deployment
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Public hostnames for the deployed site/API, no scheme for ALLOWED_HOSTS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example

# Only needed if the frontend and backend are served from different origins.
# When using the included frontend nginx proxy, same-origin /api calls do not need CORS.
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Set to 1 when TLS is terminated before Django and X-Forwarded-Proto is set correctly.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_PROXY_SSL_HEADER=1

# OAuth backend credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# OAuth frontend build-time values
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

POSTGRES_DB=hire_power
POSTGRES_USER=hire_power
FRONTEND_PORT=80
