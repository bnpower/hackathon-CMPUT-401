# Copy this to `.env` on the Cybera RAC server, in the same directory as
# docker-compose.prod.yml, and fill in real values. docker compose loads
# `.env` automatically. Never commit the real `.env` file.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=203.0.113.10
CORS_ALLOWED_ORIGINS=http://203.0.113.10

DB_NAME=jobtracker
DB_USER=jobtracker
DB_PASSWORD=replace-with-a-strong-password

# Baked into the frontend at build time (Vite env vars are compile-time).
VITE_API_URL=http://203.0.113.10:8000/api
