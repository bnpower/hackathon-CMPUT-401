DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DATABASE_URL=postgres://hire_power:replace-with-password@db:5432/hire_power

# Only set cross-origin CORS when the API is served from a different origin than the frontend.
# Do not use wildcards.
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example

DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_PROXY_SSL_HEADER=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
