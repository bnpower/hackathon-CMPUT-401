DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE as sqlite3 for local dev without Docker.
# docker-compose overrides these to point at the postgres service.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
